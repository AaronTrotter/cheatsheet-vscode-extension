{
  "name": "aaronscheatsheet",
  "displayName": "Cheatsheet Sidekick",
  "description": "\"Built for Me, Too Good to Keep to Myself.\" Search, insert, and save Cheatsheet snippets without leaving the editor.",
  "version": "0.0.4",
  "publisher": "AaronTrotter",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AaronTrotter/cheatsheet-vscode-extension.git"
  },
  "bugs": {
    "url": "https://github.com/AaronTrotter/cheatsheet-vscode-extension/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Snippets", "Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cheats.setApiKey",
        "title": "Cheatsheet Sidekick: Set API Key"
      },
      {
        "command": "cheats.searchSelection",
        "title": "Cheatsheet Sidekick: Search Selection"
      },
      {
        "command": "cheats.createCheat",
        "title": "Cheatsheet Sidekick: Create Cheat from Selection"
      }
    ],
    "keybindings": [
      {
        "command": "cheats.searchSelection",
        "key": "ctrl+alt+/",
        "mac": "cmd+alt+/",
        "when": "editorTextFocus"
      },
      {
        "command": "cheats.createCheat",
        "key": "ctrl+alt+.",
        "mac": "cmd+alt+.",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Cheatsheet Sidekick",
      "properties": {
        "cheats.baseUrl": {
          "type": "string",
          "default": "https://cheats.aarontrotter.com",
          "description": "Base URL of the Cheatsheet instance to search (no trailing slash). Only change this if you run your own fork of Cheatsheet elsewhere."
        },
        "cheats.limit": {
          "type": "number",
          "default": 10,
          "description": "Max number of suggestions to fetch per search."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
